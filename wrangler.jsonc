{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "muti-monitor",
  "main": "./src/worker.js",
  "compatibility_date": "2026-08-14",
  "assets": {
    "directory": "./public/",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "TRADING_DB",
      "database_name": "minimaomao-trading",
      "database_id": "cd6563b0-7524-4de1-9985-a24d2da2a330",
      "migrations_dir": "migrations"
    }
  ]
}
